                        "title": { "en": "Distance and displacement" },
                        "noteText": [
                          {
                            "contentType": "Notes",
                            "content": {
                              "en": "<p>Distance is the total path length covered by a body.&nbsp;Displacement is the shortest straight-line distance between the initial and final position.</p><p><img src=\"https://example-bucket.s3.amazonaws.com/images/distance-vs-displacement.png\" alt=\"distance vs displacement diagram\" /></p><table border=\"1\"><tbody><tr><td>&nbsp;</td><td>Distance</td><td>Displacement</td></tr><tr><td>Type</td><td>Scalar</td><td>Vector</td></tr><tr><td>Value</td><td>&ge; displacement</td><td>&le; distance</td></tr></tbody></table>"
                            }
                          }
                        ]
                      }
                    ],
