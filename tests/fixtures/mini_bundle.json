                        "questionType": "objective",
                        "questionText": { "en": "<p>State Newton's second law of motion.</p>" },
                        "solutionDescription": { "en": "<p>The rate of change of momentum of a body is directly proportional to the applied force and takes place in the direction of the force.</p>" },
