                        "noteText": [
                          {
                            "contentType": "Notes",
                            "content": {
                              "en": "<p>Newton's second law states that the rate of change of momentum of a body is directly proportional to the applied force.&nbsp;</p><p>It is written as <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>F</mi><mo>=</mo><mi>m</mi><mi>a</mi></math>, where <strong>F</strong> is force, <strong>m</strong> is mass and <strong>a</strong> is acceleration.</p>"
                            }
                          }
                        ]
                      }
                    ],
